{
  "homepage": "https://zakacoding.dev/",
  "name": "gh-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "release": "npm run release:check && npm run build && npm run deploy",
    "release:check": "node scripts/check-release-env.mjs",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "vite build && node scripts/build-project-pages.mjs && node scripts/apply-security-policy.mjs",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap-icons": "^1.10.5",
    "framer-motion": "^12.35.1",
    "laravel-echo": "^2.5.0",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "pusher-js": "^8.6.0",
    "react": "^18.2.0",
    "react-bootstrap-icons": "^1.10.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^5.2.0",
    "bootstrap": "^5.3.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.25.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "gh-pages": "6.1.1",
    "postcss": "^8.4.24",
    "react-bootstrap": "^2.7.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
