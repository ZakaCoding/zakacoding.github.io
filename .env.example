VITE_CHAT_API_URL=https://ws-chat-zakacoding.fly.dev
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=ws-chat-zakacoding.fly.dev
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_OPERATOR_REVERB_CHANNEL=operator.inbox

# Production browser configuration lives in .env.production and is committed
# because VITE_* values are public after bundling. Use .env.local only for
# optional developer overrides; npm run release does not require it.
# Never place backend secrets in a VITE_* variable.

# Development requests use Vite's /chat-api proxy to avoid browser CORS errors.
# Set this to http://127.0.0.1:8000 to develop against a local backend.
CHAT_PROXY_TARGET=https://ws-chat-zakacoding.fly.dev
